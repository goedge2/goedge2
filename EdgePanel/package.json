{
  "name": "edge-panel",
  "version": "2.0.5",
  "type": "module",
  "scripts": {
    "postinstall": "max setup",
    "dev": "max dev",
    "typecheck": "tsc -b",
    "build": "tsc -b && max build && node -e \"require('node:fs').rmSync('dist/stats.json', { force: true })\"",
    "lint": "biome lint .",
    "preview": "max preview",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/pro-components": "3.1.15-9",
    "@assistant-ui/react": "0.15.32",
    "@assistant-ui/react-markdown": "0.14.24",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "antd": "6.7.0",
    "axios": "^1.21.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "eventsource-client": "^1.2.0",
    "js-md5": "^0.9.2",
    "lodash-es": "^4.18.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "react-rnd": "10.5.3",
    "react-syntax-highlighter": "^16.1.2",
    "remark-breaks": "4.0.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@bufbuild/protobuf": "^2.16.0",
    "@tailwindcss/cli": "^4.3.4",
    "@tanstack/react-query": "^5.106.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@umijs/max": "^4.7.31",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "core-js": true,
    "core-js-pure": true,
    "es5-ext": true,
    "esbuild": true,
    "fsevents": false
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "antd": "$antd",
    "@ant-design/pro-components": "$@ant-design/pro-components",
    "@umijs/bundler-utoopack@4.7.31": {
      "less-loader": "13.1.0"
    },
    "@umijs/plugin-run@4.7.31": {
      "tsx": "4.23.15"
    }
  }
}
